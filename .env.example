# Copy to .env (never committed) and fill in.

# The household calendar server (Radicale).
CALDAV_URL=http://127.0.0.1:5232/
CALDAV_USER=david
CALDAV_PASSWORD=dev

# Calendars new items go into.
EVENTS_CALENDAR=Personal
TASKS_CALENDAR=Tasks

# Optional: the work Outlook calendar, shown read-only. Paste the ICS link from
# Outlook on the web: Settings > Calendar > Shared calendars > Publish a calendar.
# Anyone with this link can read the calendar, so treat it like a password.
WORK_CALENDAR_URL=

# The household's time zone, so "today" and meeting times are right.
TZ=America/Toronto
